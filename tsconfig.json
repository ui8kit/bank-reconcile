{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["svelte", "vite/client"],
    "paths": {
      "$lib/*": ["./src/lib/*"],
      "$ui8kit/ui": ["./src/lib/ui8kit/ui/index.ts"],
      "$ui8kit/ui/*": ["./src/lib/ui8kit/ui/*"],
      "$ui8kit/utils": ["./src/lib/ui8kit/utils/index.ts"],
      "$ui8kit/utils/*": ["./src/lib/ui8kit/utils/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.svelte", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "src/lib/ui8kit"]
}
